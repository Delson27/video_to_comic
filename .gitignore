# ===================================
# AutoComic Project - .gitignore
# ===================================

# ===================================
# Python Environment & Dependencies
# ===================================
venv/
.venv/
env/
ENV/
*.pyc
*.pyo
__pycache__/
*.so
*.egg
*.egg-info/
dist/
build/

# ===================================
# Runtime Generated Content
# ===================================

# Video uploads (users provide their own)
video/*.mp4
video/*.avi
video/*.mov
video/*.mkv
!video/.gitkeep

# Generated frames (created during processing)
frames/sub*/
frames/final/*.png
!frames/final/.gitkeep
!frames/.gitkeep

# Subtitle files (generated or uploaded)
*.srt
test*.srt
audio.mp3

# ===================================
# Generated Output Files
# ===================================

# Comic output (generated dynamically)
output/comic.pdf
output/page.html
output/page.js
output/print.html
output/snippet.pdf
output/test.html

# Keep template and asset structure
!output/page_place.js
!output/bubble.css
!output/page.css
!output/assets/

# ===================================
# Model & Data Files
# ===================================

# Pickle files (large model data)
*.pkl
CAM_data.pkl
lips.pkl

# Pre-trained models (large binary files)
*.dat
backend/speech_bubble/shape_predictor_68_face_landmarks.dat

# Wheel files (should be in requirements.txt instead)
*.whl
dlib-19.24.1-cp311-cp311-win_amd64.whl

# ===================================
# Temporary & Cache Files
# ===================================
*.tmp
*.temp
*.log
*.cache
.DS_Store
Thumbs.db
desktop.ini

# Testing folders
testing/
test_output/
temp/

# ===================================
# IDE & Editor Files
# ===================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# ===================================
# Environment Variables
# ===================================
.env
.env.local
.env.*.local
backend/.env

# ===================================
# OS Generated Files
# ===================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ===================================
# Git & Version Control
# ===================================
*.orig
*.rej

# ===================================
# Playwright Browser Binaries
# ===================================
.ms-playwright/

# ===================================
# Old/Redundant Scripts (if not deleted yet)
# ===================================
main.py
gen_frame.py
comic_html_to_pdf.py
generate_comic_pdf.py
generate_pdf.bat
RUN_PDF_GENERATOR.bat
tools/html_snippet_to_pdf.py
tools/html_to_pdf_browser.py
MULTIPLE_EXECUTION_METHODS.md
PDF_GENERATION_EASY_GUIDE.md

